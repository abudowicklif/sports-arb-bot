# Copy to a protected local file and load it into your process environment.
# Never commit this file, paste real secrets in chat, or put keys in source code.

# Polymarket signer and L2 API credentials
POLYMARKET_PRIVATE_KEY=0x_REPLACE_WITH_64_HEX_PRIVATE_KEY
POLYMARKET_API_KEY=REPLACE
POLYMARKET_API_SECRET=REPLACE
POLYMARKET_API_PASSPHRASE=REPLACE
# 0=EOA, 1=POLY_PROXY, 2=POLY_GNOSIS_SAFE, 3=POLY_1271 deposit wallet
POLYMARKET_SIGNATURE_TYPE=3
POLYMARKET_FUNDER_ADDRESS=0x_REPLACE_WITH_YOUR_POLYGON_WALLET_ADDRESS

# Kalshi production API key ID and an RSA or Ed25519 private key PEM.
# The file itself must have mode 600. Do not put the PEM in the command line.
KALSHI_API_KEY_ID=REPLACE_WITH_KALSHI_API_KEY_UUID
KALSHI_PRIVATE_KEY_PATH=/absolute/path/to/protected/kalshi-private-key.pem

# ARMING IS DISABLED BY DEFAULT. Uncomment these four lines only when you intend real orders.
# Independent manual arming is required for each venue, in addition to
# --confirm-live 'REAL FUNDS'. Omit these until you intend to submit real orders.
# POLYMARKET_LIVE_TRADING=YES
# POLYMARKET_LIVE_CONFIRM='I UNDERSTAND REAL FUNDS ARE AT RISK'
# KALSHI_LIVE_TRADING=YES
# KALSHI_LIVE_CONFIRM='I UNDERSTAND REAL FUNDS ARE AT RISK'
